      "text": "%spark.pyspark\nwindow = Window.partitionBy(\"city\").orderBy(F.desc(\"revenue_sum\"))\n\nmart_city_top_products = (\n    agg_mart\n    .withColumn(\"rank\", F.rank().over(window))\n    .filter(F.col(\"rank\") <= 2)\n    .drop(\"rank\")\n)\n\nmart_city_top_products.show()",
